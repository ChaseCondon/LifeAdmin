{
  "name": "LifeAdmin — KMP",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/android-sdk:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [
    8080,
    5037,
    5554,
    5555
  ],
  "portsAttributes": {
    "8080": { "label": "Web dev server", "onAutoForward": "openBrowser" },
    "5037": { "label": "ADB server" },
    "5554": { "label": "Android emulator console" },
    "5555": { "label": "ADB device" }
  },
  "customizations": {
    "jetbrains": {
      "backend": "IJ"
    },
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "mathiasfrohlich.Kotlin",
        "fwcd.kotlin",
        "GitHub.vscode-pull-request-github",
        "GitHub.vscode-github-actions",
        "GitHub.copilot-chat",
        "eamodio.gitlens",
        "supabase.vscode-supabase-extension",
        "pkief.material-icon-theme",
        "tal7aouy.rainbow-bracket",
        "davidanson.vscode-markdownlint",
        "christian-kohler.path-intellisense",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "editor.bracketPairColorization.enabled": true
      }
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}/.gradle,target=/home/vscode/.gradle,type=bind,consistency=cached"
  ]
}
